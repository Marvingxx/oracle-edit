<?xml version="1.0" encoding="utf-8"?>
<!--
  Oracle Edit MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build oracle-edit.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc oracle-edit.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\Oracle Edit by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch Oracle Edit" box. Installs a Start Menu shortcut, makes
  Oracle Edit the owner of `.oracle-edit`, and offers it under "Open with" for PSD/PSB and the image
  formats it reads (without taking over the user's default app for them), plus oracle-edit-cli.
  `msiexec /qn` still installs silently.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Oracle Edit"
      Manufacturer="Oracle"
      Version="$(var.Version)"
      UpgradeCode="1469BC67-8C17-471E-B60E-64BD1F696FCD"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Oracle Edit image editor" Manufacturer="Oracle" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Oracle Edit is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="OracleEditIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="OracleEditIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Marvingxx/oracle-edit" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Marvingxx/oracle-edit" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Marvingxx/oracle-edit" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Oracle Edit" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by OracleEditApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Oracle Edit" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Oracle Edit" Level="1">
      <ComponentGroupRef Id="OracleEditFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchOracleEdit"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through oracle-edit.en-us.wxl. -->
    <Property Id="OracleEditVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Oracle Edit $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Oracle Edit" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#OracleEditExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchOracleEdit" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="OracleEditFiles" Directory="INSTALLFOLDER">
      <Component Id="OracleEditApp" Guid="259BC2AC-E8FB-4279-AC07-29386093E012">
        <File Id="OracleEditExe" Source="$(var.BinDir)\oracle-edit.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Oracle Edit"
              Description="Oracle Edit image editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="OracleEditIcon.exe" IconIndex="0" />
        </File>

        <!-- .oracle-edit: Oracle Edit's own format; Oracle Edit is its default app. -->
        <ProgId Id="OracleEdit.Document" Description="Oracle Edit Document" Icon="OracleEditExe" IconIndex="0">
          <Extension Id="oracle-edit" ContentType="application/x-oracle-edit">
            <Verb Id="open" Command="Open" TargetFile="OracleEditExe" Argument="&quot;%1&quot;" />
          </Extension>
          <!-- .pcraft: the same format under its name from before the Oracle rename. -->
          <!-- Both extensions share the ProgId's open command; declaring it twice duplicates registry rows. -->
          <Extension Id="pcraft" ContentType="application/x-oracle-edit" />
        </ProgId>
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="OracleEdit.PhotoshopDocument" Description="PSD Document" Icon="OracleEditExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\OracleEdit.PhotoshopDocument\shell\open\command" Value="&quot;[#OracleEditExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="OracleEdit.Image" Description="Image" Icon="OracleEditExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\OracleEdit.Image\shell\open\command" Value="&quot;[#OracleEditExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psd\OpenWithProgids" Name="OracleEdit.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psb\OpenWithProgids" Name="OracleEdit.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdn\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ora\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.kra\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.krz\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tif\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tiff\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.webp\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.gif\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.bmp\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tga\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.exr\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.hdr\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.avif\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.qoi\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ico\OpenWithProgids" Name="OracleEdit.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "oracle-edit"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe" Name="FriendlyAppName" Value="Oracle Edit" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\shell\open\command" Value="&quot;[#OracleEditExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".oracle-edit" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".pcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".psd" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".psb" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".pdn" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".ora" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".kra" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".krz" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".gif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".bmp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".tga" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".exr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".hdr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".avif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".qoi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-edit.exe\SupportedTypes" Name=".ico" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\oracle-edit.exe" Value="[#OracleEditExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Oracle Edit" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="OracleEditCli">
        <File Id="OracleEditCliExe" Source="$(var.BinDir)\oracle-edit-cli.exe" KeyPath="yes" />
      </Component>

      <!-- Licences: the app's, and those of the fonts built into it (OFL-1.1 asks that they ship with them). -->
      <!-- One file per component: unversioned files can't share one with a generated guid. -->
      <Component Id="LicenseMit"><File Id="LicenseMit" Source="$(var.RootDir)\LICENSE-MIT" Name="LICENSE-MIT.txt" KeyPath="yes" /></Component>
      <Component Id="LicenseApache"><File Id="LicenseApache" Source="$(var.RootDir)\LICENSE-APACHE" Name="LICENSE-APACHE.txt" KeyPath="yes" /></Component>
      <Component Id="Notice"><File Id="Notice" Source="$(var.RootDir)\NOTICE" Name="NOTICE.txt" KeyPath="yes" /></Component>
      <Component Id="OflInter"><File Id="OflInter" Source="$(var.RootDir)\assets\fonts\OFL-Inter.txt" KeyPath="yes" /></Component>
      <Component Id="OflJetBrainsMono"><File Id="OflJetBrainsMono" Source="$(var.RootDir)\assets\fonts\OFL-JetBrainsMono.txt" KeyPath="yes" /></Component>
      <Component Id="OflLexend"><File Id="OflLexend" Source="$(var.RootDir)\assets\fonts\OFL-Lexend.txt" KeyPath="yes" /></Component>
    </ComponentGroup>
  </Fragment>
</Wix>
